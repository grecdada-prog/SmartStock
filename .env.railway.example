# Variables d'environnement pour Railway
# Copier ces valeurs dans Railway Dashboard → Variables

APP_NAME=SmartStock
APP_ENV=production
APP_DEBUG=false
APP_URL=${{RAILWAY_PUBLIC_DOMAIN}}
# APP_KEY sera généré automatiquement

# Base de données PostgreSQL (Railway génère automatiquement ces variables)
# Pas besoin de les configurer manuellement!
# Railway crée: DATABASE_URL, PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD

DB_CONNECTION=pgsql
DB_HOST=${{PGHOST}}
DB_PORT=${{PGPORT}}
DB_DATABASE=${{PGDATABASE}}
DB_USERNAME=${{PGUSER}}
DB_PASSWORD=${{PGPASSWORD}}

# Cache & Session
CACHE_DRIVER=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database
SESSION_LIFETIME=120

# Email SendGrid
MAIL_MAILER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=${{SENDGRID_API_KEY}}
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@votre-domaine.com
MAIL_FROM_NAME="${APP_NAME}"

# Logs
LOG_CHANNEL=stack
LOG_LEVEL=error

# Autres
BROADCAST_DRIVER=log
FILESYSTEM_DISK=local
