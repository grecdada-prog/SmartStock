# Exemple de variables d'environnement pour Render
# Copier ces valeurs dans Render Dashboard → Environment Variables

APP_NAME=SmartStock
APP_ENV=production
APP_DEBUG=false
APP_URL=https://votre-app.onrender.com
# APP_KEY sera généré automatiquement par Render

# Base de données PostgreSQL (copier depuis smartstock-db)
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=smartstock
DB_USERNAME=
DB_PASSWORD=

# Cache & Session
BROADCAST_DRIVER=log
CACHE_DRIVER=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Email SendGrid
MAIL_MAILER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD= # Votre SENDGRID_API_KEY
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@votre-domaine.com
MAIL_FROM_NAME="${APP_NAME}"
SENDGRID_API_KEY=

# Logs
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Autres
VITE_APP_NAME="${APP_NAME}"
